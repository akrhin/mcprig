    { "id": "hermes", "type": "external", "label": "Hermes", "sublabel": "own client, set ha", "pos": [40, 430], "size": [170, 68] },

    { "id": "main", "type": "backend", "label": "mcprig serve :9101", "sublabel": "set main · 11 servers", "tag": "5 meta-tools", "pos": [300, 110], "size": [200, 96] },
    { "id": "core", "type": "backend", "label": "proxy core", "sublabel": "catalog · tool-out · /stats", "pos": [300, 250], "size": [200, 96] },
