    { "id": "claude-to-main", "from": "claude", "to": "main" },
    { "id": "hermes-to-ha", "from": "hermes", "to": "ha" },

    { "id": "main-to-core", "from": "main", "to": "core" },
    { "id": "ha-to-core", "from": "ha", "to": "core" },

    { "id": "main-to-stdio", "from": "main", "to": "stdio", "label": "spawn + env" },
    { "id": "main-to-http", "from": "main", "to": "http", "label": "url + headers" },
    { "id": "ha-to-http", "from": "ha", "to": "http" },

    { "id": "panel-to-ha", "from": "panel", "to": "ha", "label": "start/stop", "variant": "dashed", "fromSide": "top", "toSide": "bottom" },
    { "id": "panel-to-disk", "from": "panel", "to": "disk", "label": "config · env", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Context economy",
      "items": [
        "The set's 421 tools never enter the prompt: the agent sees 5 meta-tools",
        "list_commands serves the catalog on demand, cache 8–12 ms vs 27 ms",
        "describe_commands returns the schema of just the tool being called",
        "invoke_many — a batch of calls in one response instead of N round-trips",
        "maxBytes trims a large result; the full text lands in a tool-out file"
      ]
    },
    {
      "dot": "emerald",
      "title": "The agent works as usual",
      "items": [
        "The harness is unchanged: the same tools/call and JSON-RPC on /mcp",
        "Tool names are real: invoke_command{server, command_name, parameters}",
        "Errors come back as tool text: unknown server, Unknown tool",
        "/stats counts calls and errors per server, health every 60 s"
      ]
    },
    {
      "dot": "rose",
      "title": "Transports and tokens",
      "items": [
        "stdio: spawn(command) + set env, initialize handshake (2025-11-25)",
        "HTTP: server/discover (2026-07-28), OAuth on 401",
        "One bearer token per set: main.key / ha.key",
        "Sets are panel children or mcprig-set@ units"
      ]
    }
  ]
}
