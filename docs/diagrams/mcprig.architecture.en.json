    { "id": "http", "type": "cloud", "label": "HTTP servers", "sublabel": "serena · gitea · raven", "tag": "server/discover", "pos": [620, 230], "size": [200, 96] },

    { "id": "panel", "type": "backend", "label": "panel :9088", "sublabel": "start · keys · logs", "pos": [300, 570], "size": [200, 76] },
    { "id": "disk", "type": "database", "label": "config and data", "sublabel": "keys · secrets · tool-out", "pos": [620, 570], "size": [200, 76] }
  ],
  "boundaries": [
    { "kind": "security-group", "label": "a set = one MCP server · bearer token", "wraps": ["main", "core", "ha"] }
  ],
  "connections": [
    { "id": "prompt-to-opencode", "from": "prompt", "to": "opencode", "variant": "dashed" },
