  "cards": [
    {
      "dot": "cyan",
      "title": "Экономия контекста",
      "items": [
        "Каталог не в промпте: агент видит 5 мета-тулов",
        "list_commands отдаёт каталог по запросу и кэширует",
        "describe_commands: схема только зовомого инструмента",
        "invoke_many: пачка вызовов вместо N кругов",
        "maxBytes режет ответ, полный текст остаётся файлом"
      ]
    },
    {
      "dot": "emerald",
      "title": "Клиенту менять нечего",
      "items": [
        "Харнесс не меняется: те же tools/call и JSON-RPC на /mcp",
        "Имена инструментов настоящие: invoke_command{server, command_name, parameters}",
        "Ошибка приходит текстом инструмента: неизвестный сервер, неизвестный инструмент",
        "Статистика по серверам, health опрашивается сам"
      ]
    },
    {
      "dot": "rose",
      "title": "Транспорты и токены",
      "items": [
        "stdio: spawn(command) + своё окружение, рукопожатие initialize",
        "HTTP: server/discover, OAuth по 401",
        "Bearer-токен на набор, у клиента свой набор",
        "Набор — дочерний процесс панели или свой юнит"
      ]
    },
    {
      "dot": "rose",
      "title": "Песочница",
      "items": [
        "untrusted без песочницы не стартует: fail-closed",
        "ro заменяет умолчания целиком, пути перечисляй сам",
        "prlimit берётся с хоста (alpine: пакет util-linux); лимиты AS/NPROC/FSIZE",
        "node: memoryMb ≥ 2048 и ro на префикс узла",
        "Изоляция: /home, сеть, /proc/1, запись в корень"
      ]
    }
  ]
