# Шаблон на один набор. Ставится как mcprig-warm@.service:
#   install -Dm644 deploy/mcprig-warm.service ~/.config/systemd/user/mcprig-warm@.service
# Имя с @ обязательно: %i — имя набора, у обычного юнита он пуст.
[Unit]
Description=mcprig warm set %i
Documentation=file://%h/.config/mcprig/sets/%i/servers.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Панель даёт порт набора и пароль для /api/sets. Порт панели задаётся
# MCPRIG_PANEL_URL: значение ниже — дефолт, файл panel.env его переопределяет
# (он объявлен позже, поэтому выигрывает). Если панель открыта или вызов идёт
# с явным --url, ни то, ни другое не нужно.
Environment=MCPRIG_PANEL_URL=http://127.0.0.1:9088
EnvironmentFile=-%h/.config/mcprig/panel.env
# MCPRIG_PASSWORD из общего env панели: без него /api/sets отвечает 401.
EnvironmentFile=-%h/.config/mcprig/env
ExecStart=%h/.local/bin/mcprig warm --set %i
SyslogIdentifier=mcprig-warm-%i
NoNewPrivileges=yes
PrivateTmp=yes
